# Copy to .env and fill in your secrets.
# Network configuration (RPC URL, chain ID, contract addresses) is managed by just-foundry:
#   just switch <network>   select a network (e.g. sepolia, mainnet, ...)
#   just env                show the resolved values and their sources

# Required for deployment
DEPLOYER_KEY=0x

# Required for contract verification (when VERIFIER=etherscan)
ETHERSCAN_API_KEY=

# Optional: overrides the public RPC endpoint from just-foundry (recommended for fork tests)
# RPC_URL=

# Optional (Deploy): ENS subdomain of the new plugin repo.
# Defaults to multisig-<timestamp> (safe for dev/test). Set to "multisig" for production deployments.
# MULTISIG_ENS_SUBDOMAIN=multisig
